<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WzComparerX.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="WzComparerX.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="WzComparerX">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*" Margin="16" RowSpacing="10">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="Path" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1"
                     Text="{Binding PathText}"
                     PlaceholderText="WZ file, folder, or synthetic fixture"/>
            <Button Grid.Column="2" Content="Browse">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="Open Wz..." Click="OpenResourceFileMenuItem_OnClick"/>
                        <MenuItem Header="Open Folder..." Click="OpenResourceFolderMenuItem_OnClick"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button Grid.Column="3"
                    Command="{Binding LoadCommand}"
                    Content="Load"/>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,2*,Auto,120,Auto,80,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="IMG" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1"
                     Text="{Binding SelectorText}"
                     PlaceholderText="Optional image selector"/>
            <TextBlock Grid.Column="2" Text="Key" VerticalAlignment="Center"/>
            <TextBox Grid.Column="3" Text="{Binding KeyText}"/>
            <TextBlock Grid.Column="4" Text="Depth" VerticalAlignment="Center"/>
            <TextBox Grid.Column="5" Text="{Binding DepthText}"/>
            <Button Grid.Column="6"
                    Command="{Binding OpenSelectedPackageCommand}"
                    Content="Open Package"/>
            <Button Grid.Column="7"
                    Command="{Binding InspectSelectedImageCommand}"
                    Content="Inspect Image"/>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="2*,3*" ColumnSpacing="12">
            <Border Classes="panel">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                    <TextBlock Classes="section-title" Text="Resources"/>
                    <TextBlock Grid.Row="1"
                               Text="{Binding StatusMessage}"
                               TextTrimming="CharacterEllipsis"/>
                    <TreeView Grid.Row="2"
                              ItemsSource="{Binding RootNodes}"
                              SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                              DoubleTapped="ResourcesTree_OnDoubleTapped">
                        <TreeView.DataTemplates>
                            <TreeDataTemplate DataType="vm:ResourceInspectionNodeViewModel"
                                              ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                            </TreeDataTemplate>
                        </TreeView.DataTemplates>
                    </TreeView>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,2*,*,*" RowSpacing="12">
                <Border Classes="panel">
                    <Grid RowDefinitions="Auto,*" RowSpacing="4">
                        <TextBlock Classes="section-title" Text="Document"/>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding DocumentMetadata}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ResourceMetadataItemViewModel">
                                    <Grid ColumnDefinitions="120,*" Margin="0,2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Value}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Classes="panel">
                    <Grid RowDefinitions="Auto,*" RowSpacing="4">
                        <TextBlock Classes="section-title" Text="Selection"/>
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding SelectedMetadata}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:ResourceMetadataItemViewModel">
                                        <Grid ColumnDefinitions="140,*" Margin="0,2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Value}"
                                                       TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Classes="panel">
                    <Grid RowDefinitions="Auto,*" RowSpacing="4">
                        <TextBlock Classes="section-title" Text="Diagnostics"/>
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding SelectedDiagnostics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:ResourceDiagnosticViewModel">
                                        <StackPanel Margin="0,2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Classes="panel">
                    <Grid RowDefinitions="Auto,*" RowSpacing="4">
                        <TextBlock Classes="section-title" Text="Activity"/>
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding ActivityLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:ResourceActivityLogItemViewModel">
                                        <TextBlock Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
