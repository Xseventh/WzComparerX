<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WzComparerX.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="WzComparerX.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="WzComparerX">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*" Margin="16" RowSpacing="10">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="Path" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1"
                     x:Name="PathTextBox"
                     Text="{Binding PathText}"
                     PlaceholderText="WZ/MS/MN file, folder, or synthetic fixture"/>
            <Button Grid.Column="2" x:Name="BrowseButton" Content="Browse">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="Open Package..." Click="OpenResourceFileMenuItem_OnClick"/>
                        <MenuItem Header="Open Folder..." Click="OpenResourceFolderMenuItem_OnClick"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button Grid.Column="3"
                    x:Name="LoadButton"
                    Command="{Binding LoadCommand}"
                    Content="Load"/>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,2*,Auto,120,Auto" ColumnSpacing="8">
            <TextBlock Text="IMG" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1"
                     x:Name="SelectorTextBox"
                     Text="{Binding SelectorText}"
                     PlaceholderText="Optional IMG selector"/>
            <TextBlock Grid.Column="2" Text="Key" VerticalAlignment="Center"/>
            <TextBox Grid.Column="3" Text="{Binding KeyText}"/>
            <Button Grid.Column="4"
                    x:Name="LoadImageButton"
                    Command="{Binding LoadImageCommand}"
                    Content="Load IMG"/>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="2*,3*" ColumnSpacing="12">
            <Border Classes="panel">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,*" RowSpacing="8">
                    <TextBlock Classes="section-title" Text="Resources"/>
                    <TextBlock Grid.Row="1"
                               x:Name="StatusTextBlock"
                               Text="{Binding StatusMessage}"
                               TextTrimming="CharacterEllipsis"/>
                    <TreeView Grid.Row="2"
                              x:Name="ResourcesTree"
                              ItemsSource="{Binding RootNodes}"
                              SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                              DoubleTapped="ResourcesTree_OnDoubleTapped">
                        <TreeView.DataTemplates>
                            <TreeDataTemplate DataType="vm:ResourceInspectionNodeViewModel"
                                              ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                            </TreeDataTemplate>
                        </TreeView.DataTemplates>
                    </TreeView>
                    <TextBlock Grid.Row="3"
                               Classes="section-title"
                               Text="IMG Content"
                               Margin="0,10,0,0"/>
                    <TextBlock Grid.Row="4"
                               x:Name="ImageContentStatusTextBlock"
                               Text="{Binding ImageContentStatus}"
                               TextTrimming="CharacterEllipsis"/>
                    <TreeView Grid.Row="5"
                              x:Name="ImageContentTree"
                              ItemsSource="{Binding ImageContentNodes}"
                              SelectedItem="{Binding SelectedImageContentNode, Mode=TwoWay}">
                        <TreeView.DataTemplates>
                            <TreeDataTemplate DataType="vm:ResourceInspectionNodeViewModel"
                                              ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                            </TreeDataTemplate>
                        </TreeView.DataTemplates>
                    </TreeView>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,*,150" RowSpacing="12">
                <Border Classes="panel">
                    <Grid RowDefinitions="Auto,*" RowSpacing="4">
                        <TextBlock Classes="section-title" Text="Document"/>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding DocumentMetadata}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ResourceMetadataItemViewModel">
                                    <Grid ColumnDefinitions="120,*" Margin="0,2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Value}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Classes="panel">
                    <TabControl x:Name="DetailsTabControl">
                        <TabItem Header="Selection">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding SelectedMetadata}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ResourceMetadataItemViewModel">
                                            <Grid ColumnDefinitions="140,*" Margin="0,2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Value}"
                                                           TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Diagnostics">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding SelectedDiagnostics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ResourceDiagnosticViewModel">
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Preview">
                            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                                <TextBlock x:Name="CanvasPreviewStatusTextBlock"
                                           Text="{Binding CanvasPreviewStatus}"
                                           TextWrapping="Wrap"/>
                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="CanvasPreviewScaleTextBlock"
                                               Text="{Binding CanvasPreview.ScaleLabel}"
                                               VerticalAlignment="Center"
                                               MinWidth="82"/>
                                    <Button x:Name="CanvasPreviewAutoScaleButton"
                                            Content="Auto"
                                            Command="{Binding SetCanvasPreviewScaleCommand}"
                                            CommandParameter="auto"/>
                                    <Button Content="0.25x"
                                            Command="{Binding SetCanvasPreviewScaleCommand}"
                                            CommandParameter="0.25"/>
                                    <Button Content="0.5x"
                                            Command="{Binding SetCanvasPreviewScaleCommand}"
                                            CommandParameter="0.5"/>
                                    <Button Content="1x"
                                            Command="{Binding SetCanvasPreviewScaleCommand}"
                                            CommandParameter="1"/>
                                    <Button Content="2x"
                                            Command="{Binding SetCanvasPreviewScaleCommand}"
                                            CommandParameter="2"/>
                                    <Button Content="4x"
                                            Command="{Binding SetCanvasPreviewScaleCommand}"
                                            CommandParameter="4"/>
                                    <Button Content="8x"
                                            Command="{Binding SetCanvasPreviewScaleCommand}"
                                            CommandParameter="8"/>
                                    <Button Content="16x"
                                            Command="{Binding SetCanvasPreviewScaleCommand}"
                                            CommandParameter="16"/>
                                </StackPanel>
                                <Border Grid.Row="2"
                                        Background="#202020"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        BorderThickness="1"
                                        Padding="8">
                                    <ScrollViewer x:Name="CanvasPreviewScrollViewer"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto">
                                        <Image x:Name="CanvasPreviewImage"
                                               Source="{Binding CanvasPreview.Bitmap}"
                                               Width="{Binding CanvasPreview.DisplayWidth}"
                                               Height="{Binding CanvasPreview.DisplayHeight}"
                                               Stretch="Fill"
                                               RenderOptions.BitmapInterpolationMode="None"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>

                <Border Grid.Row="2" x:Name="ActivityLogPanel" Classes="panel">
                    <Grid RowDefinitions="Auto,*" RowSpacing="4">
                        <TextBlock Classes="section-title" Text="Activity"/>
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl x:Name="ActivityLogList"
                                          ItemsSource="{Binding ActivityLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:ResourceActivityLogItemViewModel">
                                        <TextBlock Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
